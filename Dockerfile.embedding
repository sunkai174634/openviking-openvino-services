FROM openviking-openvino-base:2026.3
WORKDIR /srv/openviking-openvino
COPY app/embedding/__init__.py /srv/openviking-openvino/embedding/__init__.py
COPY app/embedding/config.py /srv/openviking-openvino/embedding/config.py
COPY app/embedding/main.py /srv/openviking-openvino/embedding/main.py
EXPOSE 8000
CMD ["uvicorn", "embedding.main:app", "--host", "0.0.0.0", "--port", "8000"]
